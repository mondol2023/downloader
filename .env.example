# ---------------------------------------------------------------------------
# Shared secrets
# ---------------------------------------------------------------------------
# HMAC key used by Express to sign stream grants and by Next.js to verify them.
# Both services MUST share this value. Generate: openssl rand -hex 48
STREAM_SIGNING_SECRET=change-me-stream-signing-secret-min-32-chars

# ---------------------------------------------------------------------------
# Express API (apps/api)
# ---------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
# Comma separated list of browser origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://media:media@localhost:5432/media_engine?schema=public
REDIS_URL=redis://localhost:6379

# Generate: openssl rand -hex 48
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
COOKIE_DOMAIN=localhost
# Set to true behind HTTPS in production
COOKIE_SECURE=false

# Binaries resolved from PATH unless absolute paths are given
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
EXTRACTION_TIMEOUT_MS=45000
# Optional Netscape cookie jar for age/consent gated sources
YTDLP_COOKIES_FILE=
# Daily 04:00 (local) `yt-dlp -U` in API and worker; leave false for pip/apt installs
YTDLP_AUTO_UPDATE=false

# Where finished worker artifacts are written
STORAGE_DIR=./storage
# New jobs are refused with STORAGE_FULL once STORAGE_DIR exceeds this many GiB
STORAGE_MAX_GB=20
# How long a rendered artifact stays downloadable (seconds)
ARTIFACT_TTL=86400

WORKER_CONCURRENCY=2
WORKER_CONCURRENCY_PRO=4

# ---------------------------------------------------------------------------
# Regions (optional). Leave REGION=default on the main deployment; set it only on a regional VM.
# ---------------------------------------------------------------------------
# Which queues this worker consumes: download (media-jobs, or media-jobs-<REGION> on a regional VM)
# and/or extract (extract-<REGION>). Maintenance runs only on the main deployment's download worker.
# WORKER_ROLE=download
# REGION=default
# Regions that have workers deployed, and ISO country -> region (JSON).
# WORKER_REGIONS=
# COUNTRY_TO_REGION={"BD":"bd"}
# The country header (cf-ipcountry) is believed only when TRUST_PROXY=true AND the TCP peer is in
# TRUSTED_PROXY_CIDRS (comma-separated IPv4/IPv6 CIDRs or exact IPs, e.g. your CDN/ingress ranges).
# Empty list = the header is ignored.
# TRUST_PROXY=false
# TRUSTED_PROXY_CIDRS=

# Optional: mirror the download/audit ledger into a Google Sheet (see README).
# Off unless BOTH are set. Keep the key JSON OUTSIDE the repo.
SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_YEARLY=price_yyy

# ---------------------------------------------------------------------------
# Next.js (apps/web)
# ---------------------------------------------------------------------------
# Server-side only: where the BFF forwards requests. Never exposed to browser.
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_SITE_NAME=MediaEngine
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000
