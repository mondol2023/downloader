// Media Engine — persistence model.
// Redis owns hot counters (quota windows, rate limits, extraction cache);
// PostgreSQL owns everything that must survive a cache flush: identity,
// entitlement, billing state and the auditable download ledger.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Tier {
  GUEST
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
  PAUSED
}

enum JobType {
  DOWNLOAD
  TRANSCODE_AUDIO
  MUX
}

enum JobState {
  QUEUED
  EXTRACTING
  DOWNLOADING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  // Argon2id hash. Null for OAuth-only identities.
  passwordHash   String?
  displayName    String?
  emailVerified  Boolean  @default(false)
  // Denormalised effective tier. Written only by the subscription reconciler
  // so a single query answers "what may this user do".
  tier           Tier     @default(FREE)
  stripeCustomerId String? @unique
  // Soft ban / abuse control.
  disabledAt     DateTime?
  disabledReason String?
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscription   Subscription?
  refreshTokens  RefreshToken[]
  jobs           Job[]
  downloads      DownloadLog[]

  @@index([tier])
  @@index([createdAt])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSubscriptionId String             @unique
  stripePriceId        String
  status               SubscriptionStatus
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status, currentPeriodEnd])
}

// Rotating refresh tokens. Only the SHA-256 hash is stored, so a database
// dump cannot be replayed as a session.
model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  // Set when rotated; a reuse attempt on a revoked token nukes the family.
  revokedAt  DateTime?
  replacedBy String?
  familyId   String
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}

model Job {
  id            String   @id @default(cuid())
  // Null for guest jobs; guestKey carries the anonymous identity instead.
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestKey      String?
  type          JobType
  state         JobState @default(QUEUED)

  sourceUrl     String
  mediaId       String
  platform      String
  mediaTitle    String
  formatId      String
  formatLabel   String
  audioFormat   String?
  embedSubtitles Boolean @default(false)
  subtitleLang  String?

  // Tier captured at enqueue time — entitlement is evaluated against the plan
  // the user held when the job was accepted, not when it happens to run.
  tierAtRequest Tier

  percent       Int      @default(0)
  totalBytes    BigInt?
  downloadedBytes BigInt?
  stage         String?

  artifactPath  String?
  artifactBytes BigInt?
  artifactMime  String?
  fileName      String?
  expiresAt     DateTime?

  error         String?
  attempts      Int      @default(0)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  download      DownloadLog?

  @@index([userId, createdAt])
  @@index([guestKey, createdAt])
  @@index([state])
  @@index([expiresAt])
}

// Append-only ledger. The rolling 24h quota is served from Redis for speed but
// rebuilt from this table when the cache is cold or contested.
model DownloadLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestKey   String?
  jobId      String?  @unique
  job        Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  tier       Tier
  platform   String
  mediaId    String
  formatId   String
  bytes      BigInt
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([guestKey, createdAt])
  @@index([createdAt])
}

// Persistent mirror of the Redis extraction cache. Lets a cold start serve
// metadata pages (SSR/OG tags) without re-running yt-dlp.
model MediaCache {
  id         String   @id
  canonicalUrl String @unique
  platform   String
  extractor  String
  title      String
  durationSeconds Int?
  thumbnail  String?
  // Full normalised ExtractionResult minus entitlement decoration.
  payload    Json
  hitCount   Int      @default(0)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([expiresAt])
  @@index([platform])
}

// Immutable audit trail for security-relevant events.
model AuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  guestKey  String?
  action    String
  outcome   String
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

// Stripe event ids already processed — webhooks are at-least-once, so the
// handler is made idempotent by inserting here inside the same transaction.
model ProcessedWebhook {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@index([processedAt])
}
